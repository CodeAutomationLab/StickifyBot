# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Directory for temporary files during conversion
TEMP_DIR=temp

# Path to FFmpeg binary (optional, defaults to "ffmpeg" on PATH)
FFMPEG_PATH=ffmpeg

# Path to RLottie library (optional: "librlottie.so" on Linux, "bin/rlottie.dll" on Windows)
# RLOTTIE_DLL_PATH=bin/rlottie.dll

